# ── S.A.M.A.Y Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.

# ── REQUIRED in production ────────────────────────────────────────────────────

# Secret key used to sign JWT tokens.
# Generate a safe one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-32-byte-random-hex

# ── Optional overrides ────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Set to your frontend domain(s) in production.
# Default "*" is fine for local dev only.
ALLOWED_ORIGINS=*

# Override where SQLite stores its file (default: backend/railway.db)
# In Docker this is set automatically by docker-compose.yml
# DB_PATH=/data/railway.db

